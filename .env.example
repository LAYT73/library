# Database
DB_USER=library_user
DB_PASSWORD=library_password
DB_NAME=library
DB_PORT=5432
DATABASE_URL=postgresql://library_user:library_password@postgres:5432/library

# Node
NODE_ENV=development

# Backend
BACKEND_PORT=3000
API_PORT=3000

# Frontend
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# JWT
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=3600

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug
